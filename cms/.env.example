# PAYLOAD_DATABASE selects the adapter: "postgres" (production, §7/§10 of
# the proposal) or "sqlite" (local dev/tests, no external DB needed).
# Defaults to sqlite unless PAYLOAD_DATABASE=postgres or NODE_ENV=production.
PAYLOAD_DATABASE=sqlite

# For sqlite: a file path, e.g. file:./she-delivers.db
# For postgres: postgres://user:password@127.0.0.1:5432/she-delivers
DATABASE_URL=file:./she-delivers.db

PAYLOAD_SECRET=YOUR_SECRET_HERE
