# PAYLOAD_DATABASE selects the adapter: "postgres" (production, §7/§10 of
# the proposal) or "sqlite" (local dev/tests, no external DB needed).
# Defaults to sqlite unless PAYLOAD_DATABASE=postgres or NODE_ENV=production.
PAYLOAD_DATABASE=sqlite

# For sqlite: a file path, e.g. file:./she-delivers.db
# For postgres: postgres://user:password@127.0.0.1:5432/she-delivers
DATABASE_URL=file:./she-delivers.db

PAYLOAD_SECRET=YOUR_SECRET_HERE

# Email (§6.3 reminders, §6.2 invite links). Leave SMTP_HOST unset for
# local dev — emails are composed via nodemailer's jsonTransport instead
# of actually sent (see cms/README.md's "Email & session reminders").
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@she-delivers.local

# Base URL used when logging the invite link (§6.2). Defaults to
# http://localhost:3000 if unset.
# PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
