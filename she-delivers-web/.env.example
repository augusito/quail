# PAYLOAD_DATABASE selects the adapter: "postgres" for production, or
# "sqlite" for local dev/tests (no external DB needed). Defaults to sqlite
# unless PAYLOAD_DATABASE=postgres or NODE_ENV=production.
PAYLOAD_DATABASE=sqlite

# For sqlite: a file path, e.g. file:./she-delivers.db
# For postgres: postgres://user:password@127.0.0.1:5432/she-delivers
DATABASE_URL=file:./she-delivers.db

PAYLOAD_SECRET=YOUR_SECRET_HERE

# Email (session reminders, invite links) via SMTP2GO. Leave SMTP_HOST
# unset for local dev — emails are composed via nodemailer's jsonTransport
# instead of actually sent (see README.md's "Email delivery"). SMTP2GO's
# SMTP host/port/credentials are under Settings > SMTP in its dashboard.
# SMTP_HOST=mail.smtp2go.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@she-delivers.local
# EMAIL_FROM_NAME=She Delivers

# Base URL used to build the registration link in invite emails (and when
# logging it). Defaults to http://localhost:3000 if unset.
# PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Contact address shown on the public Talent Board — employers reach out
# here rather than messaging a graduate directly. Defaults to
# info@she-delivers.local if unset.
# ADMIN_CONTACT_EMAIL=info@she-delivers.local
